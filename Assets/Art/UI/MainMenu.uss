.root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: space-between;
    padding: 48px 0px 80px 0px;
}

.title {
    font-size: 64px;
    color: rgb(0, 240, 255);
    -unity-text-align: upper-center;
    letter-spacing: 12px;
    margin-top: 0px;


    border-bottom-width: 1px;
    border-color: rgba(0, 240, 255, 0.3);
    padding-bottom: 12px;
}

.button-group {
    flex-direction: column;
    align-items: center;
    justify-content: top;
    margin-top: 80px;
    flex-grow: 1;
}

.menu-button {
    width: 280px;
    height: 52px;
    margin-bottom: 68px;
    border-radius: 0px;
    border-width: 1px;
    font-size: 20px;
    letter-spacing: 18px;
    -unity-font-style: bold;
    cursor: link;
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.2s;
    transition-property: background-color, border-color, color;
}

.menu-button:last-child {
    margin-bottom: 0;
}

.start-button {
    border-color: rgb(0, 240, 255);
    color: rgb(0, 240, 255);
}

.start-button:hover {
    background-color: rgba(0, 240, 255, 0.08);
    border-color: rgb(0, 255, 255);
    color: rgb(255, 255, 255);
    text-shadow:
        0px 0px 8px rgba(0, 255, 255, 1.0),
        0px 0px 30px rgba(0, 240, 255, 0.6);
}

.start-button:active {
    background-color: rgba(0, 240, 255, 0.18);
}

.exit-button {
    border-color: rgb(255, 0, 180);
    color: rgb(255, 0, 180);
}

.exit-button:hover {
    background-color: rgba(255, 0, 180, 0.08);
    border-color: rgb(255, 60, 200);
    color: rgb(255, 255, 255);
    text-shadow:
        0px 0px 8px rgba(255, 0, 180, 1.0),
        0px 0px 30px rgba(255, 0, 180, 0.6);
}

.exit-button:active {
    background-color: rgba(255, 0, 180, 0.18);
}